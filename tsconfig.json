{
  "compilerOptions": {
    "lib": [ "ESNext", "DOM", "DOM.Iterable" ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,

    "paths": {},
    "types": ["webxr"]
  },
  "include": [ "lib", "public" ]
}
