{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,

    "paths": {
      "eerth-gl": ["./lib"],
      "eerth-gl/*": ["./lib/*"],
    },
    "types": ["webxr"],
  },
  "include": ["lib", "examples"],
}
